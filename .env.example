# =============================================================================
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Generate the two keys below with:  npm run keys:generate
# =============================================================================

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Mock mode ---------------------------------------------------------------
# true  = fixtures only. No request ever leaves the machine. Google credentials
#         are optional. This is how you work until Google approves API access.
# false = live Google Business Profile. Requires the credentials below.
MOCK_MODE=true

# --- Supabase (required in both modes) ---------------------------------------
# Project settings -> API. The service-role key bypasses RLS: server-side only,
# never in a NEXT_PUBLIC_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Project settings -> Database -> Connection string (URI). Used only by
# `npm run db:migrate`. Not read at runtime.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# --- Application secrets (required) ------------------------------------------
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
# Rotating this makes every stored token unreadable — you must reconnect Google.
TOKEN_ENCRYPTION_KEY=

# HMAC key for the admin session cookie and the OAuth state parameter.
SESSION_SECRET=

# Password for the Phase 1 console. Minimum 12 characters.
ADMIN_PASSWORD=

# --- Google OAuth (required only when MOCK_MODE=false) -----------------------
# Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web app).
# The redirect URI must match here and in Cloud Console exactly, including port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Google API tuning -------------------------------------------------------
GOOGLE_API_TIMEOUT_MS=20000
GOOGLE_API_MAX_ATTEMPTS=4
